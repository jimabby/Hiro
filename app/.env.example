# Supabase cloud sync for Hiro Mobile.
# Copy this file to `.env` and fill in your project's values
# (Supabase → Project Settings → API). Restart `expo start` after editing.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id
